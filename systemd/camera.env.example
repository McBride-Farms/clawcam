# Drop a copy of this to /etc/clawcam-offdevice/<camera>.env (e.g.
# `pond-cam.env`), edit, then:
#   systemctl daemon-reload
#   systemctl enable --now clawcam-offdevice-yolo@<camera>

# Required: RTSP URL on mediamtx, webhook URL on the receiver.
OFFDEVICE_RTSP_URL=rtsp://<mediamtx-host>:8554/<camera>
OFFDEVICE_WEBHOOK_URL=https://<webhook-receiver>/hooks/clawcam

# Optional: bearer token if the receiver requires one.
OFFDEVICE_WEBHOOK_TOKEN=

# Off-device defaults that diverge from the Pi-side defaults.
# yolov8s is the recommended "second opinion" model on a server-class
# host — bigger than the Pi's yolov8n (3.2M → 11.2M params) but still
# ~8% CPU per cam at 2 FPS on a 4C/8T x86 box. Export from ultralytics:
#   yolo export model=yolov8s.pt format=onnx imgsz=640
OFFDEVICE_MODEL=/var/lib/clawcam-offdevice/yolov8s.onnx
OFFDEVICE_MODE=event
OFFDEVICE_IDLE_S=5.0
OFFDEVICE_COOLDOWN_S=2.0

# yolo.rs reads these CLAWCAM_* env vars verbatim (shared module).
# Lower than the Pi's 0.6 for the "second opinion" role.
CLAWCAM_CONF_THRESHOLD=0.5
CLAWCAM_CLASSES=person,cat,dog,bird,bear,raccoon
CLAWCAM_YOLO_INPUT_SIZE=640
# Use all cores on a server-class host; the Pi's 4-thread cap doesn't apply.
CLAWCAM_YOLO_THREADS=8
